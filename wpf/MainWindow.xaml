<Window x:Class="EnvDataApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environmental Data Configuration Generator" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Environmental Data Configuration Generator" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20" 
                   HorizontalAlignment="Center"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Project Configuration -->
                <GroupBox Header="Project Configuration" Margin="0,0,0,20">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- File Upload -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <Label Content="Input File (.txt, .inp, .adi):"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="FilePathTextBox" Width="300" IsReadOnly="True" Margin="0,0,10,0"/>
                                <Button x:Name="BrowseButton" Content="Browse" Click="BrowseButton_Click" Width="80"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Project Name -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                            <Label Content="Project Name:"/>
                            <TextBox x:Name="ProjectNameTextBox" Width="200"/>
                        </StackPanel>

                        <!-- Input Year -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                            <Label Content="Input Year (2 digits):"/>
                            <TextBox x:Name="InputYearTextBox" Width="100"/>
                        </StackPanel>

                        <!-- Year Range -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                            <Label Content="Year Range:"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="StartYearTextBox" Width="60" Margin="0,0,10,0"/>
                                <Label Content="to"/>
                                <TextBox x:Name="EndYearTextBox" Width="60" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Configuration Management -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="SaveConfigButton" Content="Save Configuration" Click="SaveConfigButton_Click" Margin="0,0,10,0"/>
                            <Button x:Name="LoadConfigButton" Content="Load Configuration" Click="LoadConfigButton_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Sources and Pollutants -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sources -->
                    <GroupBox Grid.Column="0" Header="Sources" Margin="0,0,10,0">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="NewSourceTextBox" Width="200" Margin="0,0,10,0"/>
                                <Button x:Name="AddSourceButton" Content="Add Source" Click="AddSourceButton_Click"/>
                            </StackPanel>
                            
                            <ListBox x:Name="SourcesListBox" Grid.Row="1" Height="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Name}" Margin="0,0,5,0"/>
                                            <Button Grid.Column="1" Content="Remove" Click="RemoveSource_Click" Tag="{Binding Id}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </GroupBox>

                    <!-- Pollutants -->
                    <GroupBox Grid.Column="1" Header="Pollutants" Margin="10,0,0,0">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="NewPollutantTextBox" Width="200" Margin="0,0,10,0"/>
                                <Button x:Name="AddPollutantButton" Content="Add Pollutant" Click="AddPollutantButton_Click"/>
                            </StackPanel>
                            
                            <ListBox x:Name="PollutantsListBox" Grid.Row="1" Height="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Name}" Margin="0,0,5,0"/>
                                                <Button Grid.Column="1" Content="Remove" Click="RemovePollutant_Click" Tag="{Binding Id}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <CheckBox x:Name="IsAnnualCheckBox" Content="Annual" IsChecked="{Binding IsAnnual}" Margin="0,0,10,0"/>
                                                <CheckBox x:Name="IsShortTermCheckBox" Content="Short Term" IsChecked="{Binding IsShortTerm}" Margin="0,0,10,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" IsEnabled="{Binding IsShortTerm}">
                                                <Label Content="Interval:" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="TimeIntervalComboBox" SelectedItem="{Binding TimeInterval}" Width="80" Margin="5,0,10,0">
                                                    <ComboBoxItem Content="1"/>
                                                    <ComboBoxItem Content="2"/>
                                                    <ComboBoxItem Content="3"/>
                                                    <ComboBoxItem Content="4"/>
                                                    <ComboBoxItem Content="6"/>
                                                    <ComboBoxItem Content="8"/>
                                                    <ComboBoxItem Content="12"/>
                                                    <ComboBoxItem Content="24"/>
                                                </ComboBox>
                                                <Label Content="High Value:" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="HighValueComboBox" SelectedItem="{Binding HighValue}" Width="60" Margin="5,0,0,0">
                                                    <ComboBoxItem Content="1"/>
                                                    <ComboBoxItem Content="2"/>
                                                    <ComboBoxItem Content="3"/>
                                                    <ComboBoxItem Content="4"/>
                                                    <ComboBoxItem Content="5"/>
                                                    <ComboBoxItem Content="6"/>
                                                    <ComboBoxItem Content="7"/>
                                                    <ComboBoxItem Content="8"/>
                                                    <ComboBoxItem Content="9"/>
                                                    <ComboBoxItem Content="10"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- Source-Pollutant Pairs -->
                <GroupBox Header="Emission Rates" Margin="0,0,0,20">
                    <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PairsContainer" Margin="10"/>
                    </ScrollViewer>
                </GroupBox>

                <!-- NO2 Configuration -->
                <GroupBox x:Name="No2ConfigGroupBox" Header="NO2 Configuration" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel Margin="10">
                        <TextBlock Text="⚠️ NO2 Pollutant Detected: NO2 requires additional configuration that will be inserted between CO STARTING and CO FINISHED sections." 
                                   Foreground="Orange" Margin="0,0,0,10"/>
                        <Label Content="NO2 Configuration:"/>
                        <TextBox x:Name="No2ConfigTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="** NO2 CONVERSION OPTIONS&#x0a;NO2STACK 0.200&#x0a;NO2EQUIL 0.900"/>
                    </StackPanel>
                </GroupBox>

                <!-- Generate Button -->
                <Button x:Name="GenerateButton" Content="Generate Configurations" 
                        Click="GenerateButton_Click" Height="40" FontSize="16" FontWeight="Bold"
                        Background="LightBlue" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
